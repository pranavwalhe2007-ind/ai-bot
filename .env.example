# ==============================================================================
# IntelliBot AI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
#   1. NEVER commit your actual '.env.local' or secrets to Git.
#   2. The Gemini API key and Supabase Service Role key are server-only secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Provider Configuration (Google Gemini API)
# ------------------------------------------------------------------------------
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supported model choices:
#   - gemini-1.5-flash (Fast, cost-efficient, high rate limits - Recommended)
#   - gemini-1.5-pro (High intelligence, reasoning)
#   - gemini-2.0-flash (Experimental / latest)
AI_MODEL_NAME=gemini-1.5-flash

# Optional AI Provider selection ('gemini' or 'demo')
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 2. Database Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Obtain from your Supabase project dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Privileged server-side key for administrative database operations (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 3. Application Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="IntelliBot AI"
NEXT_PUBLIC_APP_URL=http://localhost:3000
